// Register map of the OpenCores I2C-Master core (R. Herveille) as
// implemented by rtl/verilog/i2c_master_top.v at freecores/i2c dba90b2
// ("R76": OpenCores SVN rev 76, the last master-only RTL).
//
// This describes the RTL as built, not the 2003 PDF specification. Where
// the two differ, the description says so; see docs/reference/deviations.md.
// The registers themselves are in oc_i2c_regs.rdl, shared with fw-i2c's map
// (fw_i2c_regs.rdl).
//
// Bus: 8-bit WISHBONE Classic, wb_adr_i[2:0], one register per byte address.
// Registers at 0x3 and 0x4 are split: a write reaches one register (TXR,
// CR) and a read returns another (RXR, SR).

addrmap oc_i2c_master {
    name = "OpenCores I2C-Master (R76)";
    desc = "Register map of the OpenCores I2C-Master core as implemented at
            freecores/i2c dba90b2 (OpenCores SVN rev 76).";

    default regwidth = 8;
    default accesswidth = 8;
    default sw = rw;
    default hw = r;

    `define OC_I2C_STRIDE 1
    `include "oc_i2c_regs.rdl"
    `undef OC_I2C_STRIDE
};
