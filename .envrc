
if [ -d packages ]; then
  if [ -f packages/packages.envrc ]; then
    source_env packages/packages.envrc
  fi
else
  source_up_if_exists
fi


# Resource caps for this project (the machine OOMs otherwise):
#   DFM_JOBS  - at most 2 dfm tasks (builds/sims) run at once
#   DFM_CORES - each task (eg a Verilator build's verilate + make) uses <= 8 cores
export DFM_JOBS=2
export DFM_CORES=8
